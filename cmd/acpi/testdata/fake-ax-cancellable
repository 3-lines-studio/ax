#!/bin/sh
# Stand-in for `ax --events` that blocks mid-turn until it sees
# {"type":"cancel"} on stdin, then reports outcome:"cancelled" -- exercises
# acpi's Cancel path (writing to the running ax subprocess's stdin).
echo "fake-ax-cancellable invoked with: $*" >&2
printf '{"type":"protocol","version":1}\n'
printf '{"type":"assistant_delta","text":"starting a long task...\\n"}\n'
while IFS= read -r line; do
  case "$line" in
    *'"type":"cancel"'*) break ;;
  esac
done
printf '{"type":"done","outcome":"cancelled"}\n'
